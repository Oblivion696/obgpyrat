# Copia questo file in ".env" per i test in locale (non committare mai ".env" con i valori reali).
# Vedi il README.md per la guida passo-passo su come ottenere ciascun valore.

# Developer Token ottenuto dal tuo account Manager (MCC) Google Ads.
# Dal 09/09/2026 Google lo accetta ancora ma lo IGNORA per decidere l'accesso (vedi README, sezione "Novita 2026").
# Lascialo comunque impostato: alcuni strumenti/anteprime lo richiedono ancora come intestazione.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Client ID e Client Secret OAuth2 creati nella Google Cloud Console (tipo "Desktop app" o "Web application").
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh Token ottenuto UNA VOLTA tramite il flusso di consenso OAuth2 (vedi README).
# Non scade mai (a meno che tu non revochi l'accesso), quindi va generato una sola volta.
GOOGLE_ADS_REFRESH_TOKEN=

# OPZIONALE: l'ID del tuo account Manager (MCC), SENZA TRATTINI (es. 1234567890).
# Obbligatorio solo se operi su un account cliente attraverso un account Manager.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# OPZIONALE: versione dell'API Google Ads da usare. Se non impostata usa il default del server (vedi src/constants.ts).
GOOGLE_ADS_API_VERSION=

# OPZIONALE: porta HTTP quando TRANSPORT=http (default 3000).
PORT=

# Trasporto: "stdio" (default, per uso locale/MCP Inspector) oppure "http" (server remoto Streamable HTTP).
TRANSPORT=

# OBBLIGATORIO quando TRANSPORT=http: una password lunga e casuale a tua scelta,
# per impedire che chiunque conosca l'URL pubblico possa usare il server.
# Genera un valore con: openssl rand -hex 32
# Va impostato IDENTICO sia qui sia nel connettore personalizzato di claude.ai
# (come header "Authorization: Bearer <questo-valore>").
MCP_AUTH_TOKEN=
